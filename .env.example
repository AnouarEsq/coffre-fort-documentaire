# ============================================================
# Coffre-fort documentaire — configuration locale
# Copier vers .env puis adapter. NE JAMAIS COMMITTER .env.
# ============================================================

APP_NAME="Coffre-fort documentaire"
APP_TIMEZONE=Europe/Paris
APP_DEBUG=0
APP_DEMO_MODE=1

# --- PostgreSQL -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=coffre_fort
DB_USER=coffre_app
DB_PASSWORD=change-me-strong-app-password
# Compte superutilisateur utilisé UNIQUEMENT par scripts/init_db.php
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-me-admin-password

# --- Python / cryptographie ------------------------------------
# Sous Windows, indiquer si besoin le chemin absolu de python.exe
PYTHON_BIN=python
CRYPTO_TIMEOUT=60

# Keystore. Par défaut : crypto/keystore/master.key
# COFFRE_MASTER_KEY_FILE=C:\chemin\absolu\master.key
# Uniquement si le keystore est protégé par OpenSSL (fichier .enc) :
# COFFRE_KEY_PASSPHRASE=phrase-de-passe-du-keystore

# --- Sessions / uploads ----------------------------------------
SESSION_NAME=COFFRE_SESSID
SESSION_LIFETIME=1800
UPLOAD_MAX_BYTES=10485760
